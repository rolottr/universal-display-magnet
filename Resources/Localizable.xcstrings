    "Arrange your windows, then Save Workspace. Restore it any time from here or with its shortcut." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uspořádejte okna a pak zvolte Uložit pracovní prostor. Obnovit ho můžete kdykoli odsud nebo jeho zkratkou."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordnen Sie Ihre Fenster an und wählen Sie dann „Arbeitsbereich sichern“. Sie können ihn jederzeit hier oder mit seinem Kurzbefehl wiederherstellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Organice sus ventanas y elija Guardar espacio de trabajo. Restáurelo cuando quiera desde aquí o con su función rápida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disposez vos fenêtres, puis choisissez Enregistrer l’espace de travail. Restaurez-le à tout moment d’ici ou avec son raccourci."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rendezd el az ablakokat, majd válaszd a Munkaterület mentése lehetőséget. Bármikor visszaállíthatod innen vagy a billentyűparancsával."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disponi le finestre, poi scegli Salva spazio di lavoro. Ripristinalo in qualsiasi momento da qui o con la sua abbreviazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウインドウを並べてから「ワークスペースを保存」を選択します。ここから、またはショートカットでいつでも復元できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "윈도우를 배치한 다음 작업 공간을 저장하십시오. 언제든지 여기에서 또는 단축키로 복원할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rangschik uw vensters en kies dan “Bewaar werkruimte”. Zet de werkruimte op elk moment terug vanaf hier of met de bijbehorende toetscombinatie."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozmieść okna, a następnie wybierz Zapisz obszar roboczy. Przywrócisz go w dowolnej chwili stąd lub za pomocą jego skrótu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Organize as janelas e escolha Salvar Espaço de Trabalho. Restaure-o quando quiser daqui ou pelo atalho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Расставьте окна и нажмите «Сохранить рабочее пространство». Восстановить его можно в любой момент отсюда или сочетанием клавиш."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ordna dina fönster och välj sedan Spara arbetsyta. Återställ den när som helst härifrån eller med dess kortkommando."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pencerelerini yerleştir, sonra Çalışma Alanını Kaydet'i seç. İstediğin zaman buradan veya kısayoluyla geri yükle."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Розставте вікна й натисніть «Зберегти робочий простір». Відновити його можна будь-коли звідси або його скороченням."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "排列好窗口，然后存储工作区。随时可以从这里或使用其快捷键恢复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "排列好視窗，然後儲存工作區。隨時可從這裡或使用其快速鍵還原。"
          }
        }
      }
    },
