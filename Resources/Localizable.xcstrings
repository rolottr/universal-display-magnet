    "Download opens the release page on GitHub. Replace the app in your Applications folder with the new one." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tlačítko Stáhnout otevře stránku vydání na GitHubu. Nahraďte aplikaci ve složce Aplikace novou verzí."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Herunterladen“ öffnet die Release-Seite auf GitHub. Ersetzen Sie die App in Ihrem Programme-Ordner durch die neue."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descargar abre la página de la versión en GitHub. Sustituya la app de la carpeta Aplicaciones por la nueva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Télécharger ouvre la page de la version sur GitHub. Remplacez l’app dans votre dossier Applications par la nouvelle."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Letöltés megnyitja a kiadás GitHub-oldalát. Cseréld le az appot az Alkalmazások mappában az újra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scarica apre la pagina della release su GitHub. Sostituisci l'app nella cartella Applicazioni con quella nuova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「ダウンロード」をクリックするとGitHubのリリースページが開きます。「アプリケーション」フォルダ内のアプリを新しいものに置き換えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다운로드를 클릭하면 GitHub의 릴리스 페이지가 열립니다. 응용 프로그램 폴더에 있는 앱을 새 앱으로 교체하십시오."
          }
