        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij opnieuw aansluiten van een beeldschermconfiguratie terugzetten"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy zestaw wyświetlaczy zostanie ponownie podłączony, przywróć"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando uma configuração de telas se reconectar, restaurar"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "При повторном подключении конфигурации дисплеев восстанавливать"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "När en skärmuppsättning ansluts igen, återställ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir ekran kurulumu yeniden bağlandığında geri yükle"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Після повторного під’єднання конфігурації дисплеїв відновлювати"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示器配置重新连接时恢复"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顯示器配置重新連接時還原"
          }
        }
      }
    },
    "When this Mac wakes or is unlocked, wake my other Macs too" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Když se tento Mac probudí nebo odemkne, probudit i mé další Macy"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Aufwachen oder Entsperren dieses Mac auch meine anderen Macs aufwecken"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando este Mac se active o se desbloquee, activar también mis otros Mac"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand ce Mac sort de veille ou est déverrouillé, réveiller aussi mes autres Mac"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amikor ez a Mac felébred vagy feloldják, a többi Macem is ébredjen fel"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando questo Mac si riattiva o viene sbloccato, riattiva anche gli altri miei Mac"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMacのスリープ解除時またはロック解除時に、ほかのMacのスリープも解除"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac이 깨어나거나 잠금 해제되면 다른 Mac도 깨우기"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wek ook mijn andere Macs wanneer deze Mac ontwaakt of wordt ontgrendeld"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gdy ten Mac się wybudzi lub zostanie odblokowany, wybudź też moje inne Maki"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando este Mac despertar ou for desbloqueado, despertar também meus outros Macs"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда этот Mac выходит из сна или разблокируется, будить и мои другие Mac"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Väck även mina andra Mac-datorer när den här Macen vaknar eller låses upp"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu Mac uyandığında veya kilidi açıldığında diğer Mac'lerimi de uyandır"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли цей Mac виходить зі сну або розблоковується, пробуджувати й мої інші Mac"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这台 Mac 唤醒或解锁时，同时唤醒我的其他 Mac"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
