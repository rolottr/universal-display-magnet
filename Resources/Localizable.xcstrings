    "The main display has the menu bar and opens new windows" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hlavní monitor má řádek nabídek a otevírají se na něm nová okna"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Hauptbildschirm hat die Menüleiste und öffnet neue Fenster"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La pantalla principal tiene la barra de menús y abre las ventanas nuevas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le moniteur principal affiche la barre des menus et accueille les nouvelles fenêtres"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fő kijelzőn van a menüsor, és ott nyílnak meg az új ablakok"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il monitor principale ha la barra dei menu e apre le nuove finestre"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メインディスプレイにはメニューバーが表示され、新しいウインドウが開きます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주 디스플레이에는 메뉴 막대가 있으며 새 윈도우가 열립니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
