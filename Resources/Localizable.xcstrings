          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Universal Display Magnet не має облікового запису, аналітики чи хмарного сервісу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Universal Display Magnet 没有账户、分析或云服务。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Universal Display Magnet 沒有帳號、分析或雲端服務。"
          }
        }
      }
    },
    "Universal Display Magnet on the other Mac shares its display sizes with this one automatically (same network, nothing to pair). Its displays then appear here." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Universal Display Magnet na druhém Macu automaticky sdílí velikosti svých monitorů s tímto Macem (stejná síť, nic se nepáruje). Jeho monitory se pak objeví zde."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Universal Display Magnet auf dem anderen Mac teilt seine Bildschirmgrößen automatisch mit diesem Mac (gleiches Netzwerk, keine Kopplung nötig). Seine Bildschirme erscheinen dann hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Universal Display Magnet en el otro Mac comparte automáticamente el tamaño de sus pantallas con este (misma red, sin emparejar nada). Sus pantallas aparecerán entonces aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Universal Display Magnet sur l’autre Mac partage automatiquement la taille de ses moniteurs avec celui-ci (même réseau, aucun jumelage). Ses moniteurs apparaissent alors ici."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A másik Macen futó Universal Display Magnet automatikusan megosztja ezzel a Mackel a kijelzői méretét (ugyanaz a hálózat, nincs párosítás). Ezután a kijelzői itt jelennek meg."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Universal Display Magnet sull'altro Mac condivide automaticamente le dimensioni dei suoi monitor con questo (stessa rete, nessun abbinamento). I suoi monitor compariranno quindi qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "もう一方のMacのUniversal Display Magnetが、ディスプレイのサイズをこのMacと自動的に共有します（同じネットワーク上にあればよく、ペアリングは不要です）。共有されると、そのMacのディスプレイがここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 Mac의 Universal Display Magnet이 디스플레이 크기를 이 Mac과 자동으로 공유합니다(같은 네트워크에 있으면 되며 페어링할 필요 없음). 그러면 해당 Mac의 디스플레이가 여기에 나타납니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Universal Display Magnet op de andere Mac deelt de beeldschermformaten automatisch met deze Mac (zelfde netwerk, niets te koppelen). De beeldschermen van die Mac verschijnen dan hier."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Universal Display Magnet na drugim Macu automatycznie udostępnia temu Macowi rozmiary swoich wyświetlaczy (ta sama sieć, bez parowania). Jego wyświetlacze pojawią się wtedy tutaj."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Universal Display Magnet no outro Mac compartilha automaticamente os tamanhos das telas dele com este (mesma rede, sem emparelhamento). As telas dele então aparecem aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Universal Display Magnet на другом Mac автоматически сообщает этому Mac размеры своих дисплеев (та же сеть, ничего не нужно связывать). После этого его дисплеи появятся здесь."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Universal Display Magnet på den andra Macen delar automatiskt sina skärmstorlekar med den här (samma nätverk, inget att parkoppla). Dess skärmar visas sedan här."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diğer Mac'teki Universal Display Magnet, ekran boyutlarını bu Mac ile otomatik olarak paylaşır (aynı ağ, eşleştirme gerekmez). Ardından o Mac'in ekranları burada görünür."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Universal Display Magnet на іншому Mac автоматично передає цьому Mac розміри своїх дисплеїв (та сама мережа, нічого не треба поєднувати). Після цього його дисплеї з’являться тут."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一台 Mac 上的 Universal Display Magnet 会自动与这台 Mac 共享其显示器尺寸（同一网络，无需配对）。随后其显示器会出现在此处。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "另一台 Mac 上的 Universal Display Magnet 會自動與這台 Mac 共享其顯示器大小（同一網路，無須配對）。之後其顯示器會出現在此處。"
          }
        }
      }
    },
