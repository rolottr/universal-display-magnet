        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배열하려면 다른 디스플레이를 연결하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sluit nog een beeldscherm aan om te rangschikken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podłącz kolejny wyświetlacz, aby rozmieszczać."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecte outra tela para organizar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключите ещё один дисплей, чтобы задать расположение."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
