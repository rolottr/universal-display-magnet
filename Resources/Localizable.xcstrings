    "Connect another display to arrange." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Připojte další monitor, abyste mohli uspořádávat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schließen Sie einen weiteren Bildschirm an, um die Anordnung zu ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conecte otra pantalla para poder organizarlas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Connectez un autre moniteur pour pouvoir les disposer."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az elrendezéshez csatlakoztass még egy kijelzőt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collega un altro monitor per poterli disporre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配置するには別のディスプレイを接続してください。"
