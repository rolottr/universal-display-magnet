    "You have %@. Download it from the GitHub release page, then replace the app in your Applications folder." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máte verzi %@. Stáhněte novou verzi ze stránky vydání na GitHubu a pak nahraďte aplikaci ve složce Aplikace."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie haben Version %@. Laden Sie die neue Version von der GitHub-Release-Seite und ersetzen Sie dann die App in Ihrem Programme-Ordner."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiene la versión %@. Descargue la nueva desde la página de la versión en GitHub y sustituya la app de la carpeta Aplicaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez la version %@. Téléchargez la nouvelle depuis la page de la version sur GitHub, puis remplacez l’app dans votre dossier Applications."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A jelenlegi verzió: %@. Töltsd le az újat a GitHub kiadási oldaláról, majd cseréld le az appot az Alkalmazások mappában."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hai la versione %@. Scarica quella nuova dalla pagina della release su GitHub, poi sostituisci l'app nella cartella Applicazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現在のバージョンは%@です。GitHubのリリースページからダウンロードし、「アプリケーション」フォルダ内のアプリを置き換えてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현재 버전은 %@입니다. GitHub 릴리스 페이지에서 다운로드한 다음 응용 프로그램 폴더에 있는 앱을 교체하십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "U hebt versie %@. Download de nieuwe versie van de GitHub-releasepagina en vervang daarna de app in uw map Programma's."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masz wersję %@. Pobierz nową ze strony wydania w serwisie GitHub, a następnie zastąp aplikację w folderze Aplikacje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você tem a versão %@. Baixe a nova na página da versão no GitHub e depois substitua o app na sua pasta Aplicativos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У вас версия %@. Загрузите новую со страницы выпуска на GitHub, а затем замените приложение в папке «Программы»."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har version %@. Hämta den nya versionen från versionssidan på GitHub och ersätt sedan appen i mappen Program."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yüklü sürüm: %@. Yenisini GitHub'daki sürüm sayfasından indir, ardından Uygulamalar klasöründeki uygulamayı değiştir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У вас версія %@. Завантажте нову зі сторінки випуску на GitHub, а потім замініть програму в папці «Програми»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您当前的版本是 %@。请从 GitHub 版本页面下载新版本，然后替换“应用程序”文件夹中的 App。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
