            "value" : "Universal Display Magnet verwendet die Sprache Ihres Mac, sofern Sie hier keine andere wählen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Universal Display Magnet usa el idioma del Mac salvo que elija otro aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Universal Display Magnet suit la langue de votre Mac, sauf si vous en choisissez une autre ici."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Universal Display Magnet a Maced nyelvét követi, hacsak nem választasz itt másikat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Universal Display Magnet usa la lingua del Mac, a meno che tu non ne scelga un'altra qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここで別の言語を選択しない限り、Universal Display MagnetはMacの言語に従います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기에서 다른 언어를 선택하지 않으면 Universal Display Magnet은 Mac의 언어를 따릅니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Universal Display Magnet volgt de taal van uw Mac, tenzij u hier een andere kiest."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Universal Display Magnet używa języka ustawionego na Macu, chyba że wybierzesz tu inny."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Universal Display Magnet segue o idioma do seu Mac, a menos que você escolha outro aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Universal Display Magnet использует язык вашего Mac, если здесь не выбран другой."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Universal Display Magnet följer språket på din Mac om du inte väljer ett annat här."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Burada başka bir dil seçmediğin sürece Universal Display Magnet, Mac'inin dilini kullanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Universal Display Magnet використовує мову вашого Mac, якщо тут не вибрано іншу."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除非您在此处选择其他语言，否则 Universal Display Magnet 会跟随 Mac 的语言。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "除非您在此處選擇其他語言，否則 Universal Display Magnet 會跟隨 Mac 的語言。"
          }
        }
      }
    },
    "Universal Display Magnet has no account, analytics or cloud service." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Universal Display Magnet nemá žádný účet, analytiku ani cloudovou službu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Universal Display Magnet hat keinen Account, keine Analysefunktionen und keinen Cloud-Dienst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Universal Display Magnet no tiene cuentas, analíticas ni servicio en la nube."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Universal Display Magnet n’a ni compte, ni statistiques, ni service cloud."
          }
