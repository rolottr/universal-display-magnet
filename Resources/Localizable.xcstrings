    "Turn on Universal Display Magnet in System Settings › Privacy & Security › Device Control and Data Access" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapněte Universal Display Magnet v Nastavení systému › Soukromí a zabezpečení › Ovládání zařízení a přístup k datům"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivieren Sie Universal Display Magnet unter Systemeinstellungen › Datenschutz & Sicherheit › Gerätesteuerung und Datenzugriff"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Active Universal Display Magnet en Ajustes del Sistema › Privacidad y seguridad › Control del dispositivo y acceso a datos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez Universal Display Magnet dans Réglages Système › Confidentialité et sécurité › Contrôle de l’appareil et accès aux données"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapcsold be a Universal Display Magnetet itt: Rendszerbeállítások › Adatvédelem és biztonság › Eszközvezérlés és adathozzáférés"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva Universal Display Magnet in Impostazioni di Sistema › Privacy e sicurezza › Controllo del dispositivo e accesso ai dati"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム設定 › プライバシーとセキュリティ › デバイスの制御とデータへのアクセスで、Universal Display Magnetをオンにしてください"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 설정 › 개인정보 보호 및 보안 › 기기 제어 및 데이터 접근에서 Universal Display Magnet을 켜십시오"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakel Universal Display Magnet in via Systeeminstellingen › Privacy en beveiliging › Apparaatbediening en gegevenstoegang"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz Universal Display Magnet w Ustawieniach systemowych › Prywatność i ochrona › Sterowanie urządzeniem i dostęp do danych"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative o Universal Display Magnet em Ajustes do Sistema › Privacidade e Segurança › Controle de Dispositivos e Acesso a Dados"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите Universal Display Magnet в разделе Системные настройки › Конфиденциальность и безопасность › Управление устройством и доступ к данным"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå på Universal Display Magnet i Systeminställningar › Integritet och säkerhet › Enhetskontroll och dataåtkomst"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistem Ayarları › Gizlilik ve Güvenlik › Aygıt Denetimi ve Veri Erişimi bölümünde Universal Display Magnet'i aç"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увімкніть Universal Display Magnet у розділі Системні параметри › Приватність і безпека › Керування пристроєм і доступ до даних"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“系统设置” › “隐私与安全性” › “设备控制与数据访问”中打开 Universal Display Magnet"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在「系統設定」›「隱私權與安全性」›「裝置控制與資料取用」中開啟 Universal Display Magnet"
          }
        }
      }
    },
    "Turn on Universal Display Magnet in System Settings › Privacy & Security › Device Control and Data Access (called Accessibility on older macOS). If it's already on but this still shows, remove it with − and turn it on again." : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zapněte Universal Display Magnet v Nastavení systému › Soukromí a zabezpečení › Ovládání zařízení a přístup k datům (ve starších verzích macOS Zpřístupnění). Pokud už je zapnutý, ale tato zpráva se stále zobrazuje, odstraňte ho tlačítkem − a zapněte ho znovu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktivieren Sie Universal Display Magnet unter Systemeinstellungen › Datenschutz & Sicherheit › Gerätesteuerung und Datenzugriff (in älteren macOS-Versionen „Bedienungshilfen“). Falls die App bereits aktiviert ist und diese Meldung trotzdem erscheint, entfernen Sie sie mit − und aktivieren Sie sie erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Active Universal Display Magnet en Ajustes del Sistema › Privacidad y seguridad › Control del dispositivo y acceso a datos (llamado Accesibilidad en versiones anteriores de macOS). Si ya está activado pero sigue apareciendo este mensaje, elimínelo con − y vuelva a activarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activez Universal Display Magnet dans Réglages Système › Confidentialité et sécurité › Contrôle de l’appareil et accès aux données (appelé Accessibilité dans les versions antérieures de macOS). S’il est déjà activé mais que ce message s’affiche encore, supprimez-le avec − puis réactivez-le."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapcsold be a Universal Display Magnetet itt: Rendszerbeállítások › Adatvédelem és biztonság › Eszközvezérlés és adathozzáférés (régebbi macOS-en: Kisegítő lehetőségek). Ha már be van kapcsolva, de ez továbbra is megjelenik, távolítsd el a − gombbal, és kapcsold be újra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attiva Universal Display Magnet in Impostazioni di Sistema › Privacy e sicurezza › Controllo del dispositivo e accesso ai dati (chiamato Accessibilità nelle versioni precedenti di macOS). Se è già attivo ma questo messaggio compare ancora, rimuovilo con − e riattivalo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム設定 › プライバシーとセキュリティ › デバイスの制御とデータへのアクセス（以前のmacOSでは「アクセシビリティ」）で、Universal Display Magnetをオンにしてください。すでにオンなのにこの表示が消えない場合は、−で削除してからもう一度オンにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 설정 › 개인정보 보호 및 보안 › 기기 제어 및 데이터 접근(이전 macOS에서는 “손쉬운 사용”)에서 Universal Display Magnet을 켜십시오. 이미 켜져 있는데도 이 메시지가 계속 표시되면 −로 제거한 다음 다시 켜십시오."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schakel Universal Display Magnet in via Systeeminstellingen › Privacy en beveiliging › Apparaatbediening en gegevenstoegang (in oudere versies van macOS “Toegankelijkheid”). Als de app al is ingeschakeld maar dit nog steeds verschijnt, verwijder haar dan met − en schakel haar opnieuw in."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Włącz Universal Display Magnet w Ustawieniach systemowych › Prywatność i ochrona › Sterowanie urządzeniem i dostęp do danych (w starszych wersjach macOS: Dostępność). Jeśli aplikacja jest już włączona, a ten komunikat nadal się wyświetla, usuń ją przyciskiem − i włącz ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ative o Universal Display Magnet em Ajustes do Sistema › Privacidade e Segurança › Controle de Dispositivos e Acesso a Dados (chamado Acessibilidade em versões mais antigas do macOS). Se já estiver ativado e isto continuar aparecendo, remova-o com − e ative-o novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Включите Universal Display Magnet в разделе Системные настройки › Конфиденциальность и безопасность › Управление устройством и доступ к данным (в более старых версиях macOS — «Универсальный доступ»). Если приложение уже включено, но это сообщение не исчезает, удалите его кнопкой − и включите снова."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slå på Universal Display Magnet i Systeminställningar › Integritet och säkerhet › Enhetskontroll och dataåtkomst (kallas Hjälpmedel i äldre versioner av macOS). Om appen redan är påslagen men detta ändå visas tar du bort den med − och slår på den igen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistem Ayarları › Gizlilik ve Güvenlik › Aygıt Denetimi ve Veri Erişimi bölümünde (eski macOS sürümlerinde adı Erişilebilirlik) Universal Display Magnet'i aç. Zaten açıksa ama bu mesaj hâlâ görünüyorsa − ile kaldırıp yeniden aç."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Увімкніть Universal Display Magnet у розділі Системні параметри › Приватність і безпека › Керування пристроєм і доступ до даних (у старіших версіях macOS — «Універсальний доступ»). Якщо програму вже ввімкнено, але це повідомлення не зникає, вилучіть її кнопкою − і ввімкніть знову."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在“系统设置” › “隐私与安全性” › “设备控制与数据访问”（旧版 macOS 中称为“辅助功能”）中打开 Universal Display Magnet。如果已打开但仍显示此信息，请用 − 将其移除，然后重新打开。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在「系統設定」›「隱私權與安全性」›「裝置控制與資料取用」（在較舊的 macOS 中稱為「輔助使用」）中開啟 Universal Display Magnet。如果已開啟但仍顯示此訊息，請用 − 將其移除，然後再次開啟。"
          }
        }
      }
    },
