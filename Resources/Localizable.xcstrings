    "Pull every display flush against its neighbours and square up near-aligned edges" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Přitáhnout každý monitor těsně k sousedním a srovnat téměř zarovnané okraje"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle Bildschirme bündig an ihre Nachbarn ziehen und fast ausgerichtete Kanten begradigen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acoplar cada pantalla borde con borde a sus vecinas y alinear los bordes casi alineados"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coller chaque moniteur bord à bord à ses voisins et aligner les bords presque alignés"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden kijelző szoros illesztése a szomszédaihoz és a majdnem igazított szélek kiegyenesítése"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Accosta ogni monitor bordo a bordo ai vicini e allinea i bordi quasi allineati"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのディスプレイを隣のディスプレイに隙間なく寄せ、ほぼ揃っている辺をきちんと揃えます"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 디스플레이를 인접한 디스플레이에 빈틈없이 붙이고 거의 맞춰진 가장자리를 정확히 정렬합니다"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schuif elk beeldscherm strak tegen zijn buren en trek bijna uitgelijnde randen recht"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przyciągnij każdy wyświetlacz na styk do sąsiednich i wyrównaj prawie wyrównane krawędzie"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encaixar todas as telas rente às vizinhas e acertar as bordas quase alinhadas"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Придвинуть каждый дисплей вплотную к соседним и выровнять почти совпадающие края"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra varje skärm kant i kant mot sina grannar och räta upp nästan inriktade kanter"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm ekranları komşularına tam yasla ve neredeyse hizalı kenarları düzelt"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Присунути кожен дисплей впритул до сусідніх і вирівняти майже суміщені краї"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将每台显示器紧贴相邻显示器，并对齐几乎对齐的边缘"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將每台顯示器緊貼相鄰顯示器，並對正幾乎對齊的邊緣"
