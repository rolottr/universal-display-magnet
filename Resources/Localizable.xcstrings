    "Displays must touch without overlapping" : {
      "localizations" : {
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Monitory se musí dotýkat a nesmí se překrývat"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bildschirme müssen sich berühren, ohne sich zu überlappen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las pantallas deben tocarse sin superponerse"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les moniteurs doivent se toucher sans se chevaucher"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kijelzőknek érintkezniük kell, átfedés nélkül"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I monitor devono toccarsi senza sovrapporsi"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスプレイは重ならずに接している必要があります"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "디스플레이는 겹치지 않고 맞닿아 있어야 함"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beeldschermen moeten elkaar raken zonder te overlappen"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyświetlacze muszą się stykać i nie mogą na siebie nachodzić"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As telas devem se tocar sem se sobrepor"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дисплеи должны соприкасаться без наложения"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skärmarna måste nudda varandra utan att överlappa"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekranlar üst üste binmeden birbirine değmeli"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дисплеї мають торкатися без накладання"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "显示器必须相接且不能重叠"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顯示器必須相接且不可重疊"
          }
        }
      }
    },
